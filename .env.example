# 复制为 .env 并在其中填入真实值；.env 已被 gitignore，绝不提交。
# 也可直接以环境变量导出（生产建议用 secret 管理器）。

# 真实 LLM 生成（OpenAI 兼容 chat completions）
PRESALE_LLM_BASE_URL=https://llm.goaichat.top/v1
PRESALE_LLM_MODEL=glm-5.3
PRESALE_LLM_API_KEY=

# 可选：外部检索/向量库
# 方式 A：Qdrant（本地 Docker）——embedding 复用 LLM 提供方，或用独立 embedding
PRESALE_QDRANT_URL=http://localhost:6333
# PRESALE_QDRANT_COLLECTION=presale
# PRESALE_EMBEDDING=deterministic   # 用哈希伪向量跑通管道（无需真实 /embeddings 提供方）
# PRESALE_EMBEDDING_BASE_URL=   # 缺省复用 PRESALE_LLM_BASE_URL（需提供方支持 /embeddings）
# PRESALE_EMBEDDING_MODEL=      # 缺省复用 PRESALE_LLM_MODEL
# PRESALE_EMBEDDING_API_KEY=    # 缺省复用 PRESALE_LLM_API_KEY（需提供方支持 /embeddings）
# 方式 B：通用 search 端点（返回 {"items":[...]}）
# PRESALE_RETRIEVAL_BASE_URL=

# 可选：商品知识 catalog（JSON 文件路径）与 SQLite 数据库路径
# PRESALE_CATALOG=./catalog.json
# PRESALE_DB=./presale.sqlite3
