{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "tenant_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "agent",
        "service",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "Artifact",
          "default": "Artifact",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ErrorCategory": {
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "approval",
        "budget",
        "model",
        "tool",
        "dependency",
        "conflict",
        "cancelled",
        "timeout",
        "internal"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "ErrorSeverity",
      "type": "string"
    },
    "ExecutionLocation": {
      "enum": [
        "cloud",
        "local",
        "sandbox",
        "device",
        "gpu"
      ],
      "title": "ExecutionLocation",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PermissionDecision": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "additionalProperties": true,
          "title": "Constraints",
          "type": "object"
        },
        "decision": {
          "$ref": "#/$defs/PermissionDecisionValue"
        },
        "decision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decision Digest",
          "type": "string"
        },
        "policy_refs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "minItems": 1,
          "title": "Policy Refs",
          "type": "array"
        },
        "reason_codes": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "policy_refs",
        "reason_codes",
        "request_digest",
        "decision_digest"
      ],
      "title": "PermissionDecision",
      "type": "object"
    },
    "PermissionDecisionValue": {
      "enum": [
        "allow",
        "deny",
        "require_approval"
      ],
      "title": "PermissionDecisionValue",
      "type": "string"
    },
    "ResourceKind": {
      "enum": [
        "AgentSpec",
        "SkillManifest",
        "ToolManifest",
        "PromptPackage",
        "ModelPolicy",
        "ContextPolicy",
        "LoopProfile",
        "PermissionProfile",
        "Task",
        "AgentRun",
        "Checkpoint",
        "ToolCall",
        "Approval",
        "Artifact",
        "Event"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RuntimeMetadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Annotations",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "id",
        "revision",
        "scope",
        "created_at",
        "created_by"
      ],
      "title": "RuntimeMetadata",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^ses_[A-Za-z0-9._:-]{3,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "tenant_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        },
        "type": {
          "$ref": "#/$defs/ScopeType"
        },
        "user_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "required": [
        "type"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "system",
        "tenant",
        "user",
        "project",
        "session"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "SideEffect": {
      "enum": [
        "read_only",
        "local_write",
        "external_write",
        "external_send",
        "destructive",
        "privileged"
      ],
      "title": "SideEffect",
      "type": "string"
    },
    "StandardError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "cause_ref": {
          "anyOf": [
            {
              "pattern": "^evt_[0-9a-f-]{36}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Ref"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_to_retry": {
          "title": "Safe To Retry",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/ErrorSeverity"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "safe_to_retry",
        "severity",
        "occurred_at"
      ],
      "title": "StandardError",
      "type": "object"
    },
    "ToolCallPhase": {
      "enum": [
        "proposed",
        "validating",
        "denied",
        "waiting_approval",
        "approved",
        "rejected",
        "expired",
        "scheduled",
        "executing",
        "succeeded",
        "failed",
        "cancelled",
        "unknown"
      ],
      "title": "ToolCallPhase",
      "type": "string"
    },
    "ToolCallSpec": {
      "additionalProperties": false,
      "properties": {
        "approval_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_target": {
          "$ref": "#/$defs/ExecutionLocation"
        },
        "idempotency_key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Idempotency Key"
        },
        "input": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "$ref": "#/$defs/ArtifactRef"
            }
          ],
          "title": "Input"
        },
        "input_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "permission_decision": {
          "$ref": "#/$defs/PermissionDecision"
        },
        "requested_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "run_ref": {
          "$ref": "#/$defs/ObjectRef"
        },
        "side_effect_receipt": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side Effect Receipt"
        },
        "tool_snapshot": {
          "$ref": "#/$defs/ToolSnapshot"
        },
        "usage": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Usage",
          "type": "object"
        }
      },
      "required": [
        "run_ref",
        "tool_snapshot",
        "requested_by",
        "input",
        "input_digest",
        "permission_decision",
        "execution_target",
        "attempt"
      ],
      "title": "ToolCallSpec",
      "type": "object"
    },
    "ToolCallStatus": {
      "additionalProperties": false,
      "properties": {
        "phase": {
          "$ref": "#/$defs/ToolCallPhase"
        }
      },
      "required": [
        "phase"
      ],
      "title": "ToolCallStatus",
      "type": "object"
    },
    "ToolSnapshot": {
      "additionalProperties": false,
      "properties": {
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect"
        },
        "tool_ref": {
          "$ref": "#/$defs/ResourceRef"
        }
      },
      "required": [
        "tool_ref",
        "side_effect",
        "risk_level"
      ],
      "title": "ToolSnapshot",
      "type": "object"
    }
  },
  "$id": "https://schemas.agent-platform.local/v1alpha1/tool-call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "agent-platform/v1alpha1",
      "default": "agent-platform/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "kind": {
      "const": "ToolCall",
      "default": "ToolCall",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/RuntimeMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ToolCallSpec"
    },
    "status": {
      "$ref": "#/$defs/ToolCallStatus"
    }
  },
  "required": [
    "metadata",
    "spec",
    "status"
  ],
  "title": "ToolCallResource",
  "type": "object",
  "x-contract-version": "0.2.0",
  "x-source-model": "agent_platform_contracts.models.ToolCallResource"
}
