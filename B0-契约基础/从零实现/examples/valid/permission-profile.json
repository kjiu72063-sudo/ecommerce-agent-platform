        "resources": ["project:prj_demo/environment:production"],
        "conditions": {}
      },
      {
        "effect": "deny",
        "actions": ["secret.read_raw"],
        "resources": ["*"],
        "conditions": {}
      }
    ],
    "capabilities": ["code_execution", "file_access"],
    "default_decision": "deny",
    "deny_precedence": true,
    "cross_tenant_default": "deny"
