  "spec": {
    "roles": ["developer", "code_reviewer"],
    "rules": [
      {
        "effect": "allow",
        "actions": ["repository.read", "file.read"],
        "resources": ["project:prj_demo/repository:*"],
        "conditions": {
          "environment": ["development", "staging"]
        }
      },
      {
