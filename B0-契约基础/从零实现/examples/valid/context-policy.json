  "spec": {
    "source_rules": [
      { "source": "task", "effect": "allow", "priority": 100 },
      { "source": "agent_spec", "effect": "allow", "priority": 95 },
      { "source": "prompt", "effect": "allow", "priority": 90 },
      { "source": "skill", "effect": "allow", "priority": 80 },
      { "source": "tool_schema", "effect": "allow", "priority": 70 },
      { "source": "memory", "effect": "allow", "priority": 60 },
      { "source": "thread", "effect": "allow", "priority": 50 }
    ],
    "token_budget": {
      "total_tokens": 8000,
      "reserved_output_tokens": 2000,
      "per_source": {
        "task": 500,
        "agent_spec": 300,
        "prompt": 2000,
        "skill": 2000,
        "tool_schema": 500,
        "memory": 500,
        "thread": 200
      }
    },
    "skill_selection": {
      "top_k": 5,
      "similarity_threshold": 0.7,
      "metadata_token_limit": 500
    },
    "tool_selection": {
      "max_visible_tools": 10,
      "schema_token_limit": 1000
    },
