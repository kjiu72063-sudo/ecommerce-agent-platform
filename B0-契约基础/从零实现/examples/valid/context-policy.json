    },
    "redaction": {
      "redact_secrets": true,
      "pii_mode": "mask",
      "restricted_data_mode": "deny"
    },
    "provenance_requirement": true,
    "snapshot_policy": {
      "persist": true,
      "store_content": false,
      "retention_days": 30,
      "require_digest": true
