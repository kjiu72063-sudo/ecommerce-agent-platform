{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common-types.schema.json",
  "title": "Common Types",
  "description": "B0 契约包公共类型定义 - 所有资源对象共享的基础类型",
  "x-contract-version": "0.2.0",
  "$defs": {
    "SemVer": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "description": "语义版本号，如 1.0.0, 2.1.3-beta.1"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 内容摘要，用于验证数据完整性"
    },
    "ResourceId": {
      "type": "string",
      "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "带类型前缀的 UUIDv7 资源 ID"
    },
    "SchemaId": {
      "type": "string",
      "pattern": "^sch_[a-z0-9][a-z0-9._-]{2,127}$",
      "description": "Schema 标识符"
    },
    "Key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,126}[a-z0-9]$",
      "minLength": 3,
      "maxLength": 128,
      "description": "人类可读的标识符，如 programming-agent"
    },
    "Namespace": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,126}[a-z0-9]$",
      "minLength": 2,
      "maxLength": 128,
      "description": "命名空间，如 ecommerce, default"
    },
    "NonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "非空字符串"
    },
    "ScopeType": {
      "type": "string",
      "enum": ["system", "tenant", "user", "project", "session"],
      "description": "作用域类型"
    },
    "Scope": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/ScopeType" },
        "tenant_id": { "$ref": "#/$defs/ResourceId" },
        "user_id": { "$ref": "#/$defs/ResourceId" },
        "project_id": { "$ref": "#/$defs/ResourceId" },
        "session_id": {
          "type": "string",
          "pattern": "^ses_[A-Za-z0-9._:-]{3,128}$"
        }
      },
      "required": ["type"],
      "additionalProperties": false,
      "description": "作用域定义 - 决定资源的可见性和访问范围"
    },
    "ActorType": {
      "type": "string",
      "enum": ["user", "agent", "service", "system"],
      "description": "Actor 类型"
    },
    "ActorRef": {
      "type": "object",
      "properties": {
        "actor_type": { "$ref": "#/$defs/ActorType" },
        "actor_id": { "$ref": "#/$defs/NonEmptyString" },
        "tenant_id": { "$ref": "#/$defs/ResourceId" }
      },
      "required": ["actor_type", "actor_id"],
      "additionalProperties": false,
      "description": "Actor 引用 - 表示操作的执行者"
    },
    "ResourceKind": {
      "type": "string",
      "enum": [
        "AgentSpec", "SkillManifest", "ToolManifest", "PromptPackage",
        "ModelPolicy", "ContextPolicy", "LoopProfile", "PermissionProfile",
        "Task", "AgentRun", "Checkpoint", "ToolCall", "Approval", "Artifact", "Event"
      ],
      "description": "15 种核心资源类型"
    },
    "ResourceRef": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "id": { "$ref": "#/$defs/ResourceId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "digest": { "$ref": "#/$defs/Digest" }
      },
      "required": ["kind", "id", "version", "digest"],
      "additionalProperties": false,
      "description": "资源引用（精确版本）- 用于引用定义对象"
    },
    "ObjectRef": {
      "type": "object",
      "properties": {
        "kind": { "$ref": "#/$defs/ResourceKind" },
        "id": { "$ref": "#/$defs/ResourceId" }
      },
      "required": ["kind", "id"],
      "additionalProperties": false,
      "description": "对象引用（不含版本）- 用于引用运行对象"
    },
    "SchemaRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/SchemaId" },
        "version": { "$ref": "#/$defs/SemVer" },
        "digest": { "$ref": "#/$defs/Digest" }
      },
      "required": ["id", "version", "digest"],
      "additionalProperties": false,
      "description": "Schema 引用"
    },
    "ArtifactRef": {
      "type": "object",
      "properties": {
        "kind": { "const": "Artifact" },
        "id": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "digest": { "$ref": "#/$defs/Digest" }
      },
      "required": ["kind", "id", "digest"],
      "additionalProperties": false,
      "description": "Artifact 引用 - 用于引用大文件"
    },
    "SecretRef": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,63}$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string" }
          ]
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        }
      },
      "required": ["provider", "key", "version", "field"],
      "additionalProperties": false,
      "description": "Secret 引用 - 不存储实际密钥，只存储引用"
    },
    "TraceContext": {
      "type": "object",
      "properties": {
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^corr_[A-Za-z0-9._:-]{3,128}$"
        }
      },
      "required": ["trace_id", "span_id", "correlation_id"],
      "additionalProperties": false,
      "description": "追踪上下文 - 用于分布式追踪"
    },
    "PriceSnapshotRef": {
      "type": "object",
      "properties": {
        "snapshot_id": {
          "type": "string",
          "pattern": "^price_[A-Za-z0-9._:-]{3,128}$"
        },
        "version": { "$ref": "#/$defs/SemVer" },
        "effective_at": {
          "type": "string",
          "format": "date-time"
        },
        "digest": { "$ref": "#/$defs/Digest" }
      },
      "required": ["snapshot_id", "version", "effective_at", "digest"],
      "additionalProperties": false,
      "description": "价格快照引用 - 用于成本核算"
    },
    "Budget": {
      "type": "object",
      "properties": {
        "max_wall_time_seconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "最大执行时间（秒）"
        },
        "max_model_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "最大输入 Token"
        },
        "max_model_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "最大输出 Token"
        },
        "max_model_tokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "最大总 Token"
        },
        "max_cost_usd": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "最大费用（美元）"
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "最大工具调用次数"
        },
        "max_iterations": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "最大迭代次数"
        }
      },
      "required": ["max_wall_time_seconds", "max_model_tokens", "max_cost_usd", "max_tool_calls", "max_iterations"],
      "additionalProperties": false,
      "description": "预算定义 - 限制资源使用"
    },
    "Usage": {
      "type": "object",
      "properties": {
        "wall_time_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "实际执行时间"
        },
        "model_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "实际输入 Token"
        },
        "model_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "实际输出 Token"
        },
        "model_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "实际总 Token"
        },
        "cost_usd": {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$",
          "description": "实际费用"
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "description": "实际工具调用次数"
        },
        "iterations": {
          "type": "integer",
          "minimum": 0,
          "description": "实际迭代次数"
        },
        "price_snapshot_ref": { "$ref": "#/$defs/PriceSnapshotRef" }
      },
      "required": ["wall_time_seconds", "model_input_tokens", "model_output_tokens", "model_tokens", "cost_usd", "tool_calls", "iterations", "price_snapshot_ref"],
      "additionalProperties": false,
      "description": "使用量统计"
    },
    "ErrorCategory": {
      "type": "string",
      "enum": [
        "validation", "authentication", "authorization", "approval",
        "budget", "model", "tool", "dependency", "conflict",
        "cancelled", "timeout", "internal"
      ],
      "description": "错误分类"
    },
    "ErrorSeverity": {
      "type": "string",
      "enum": ["info", "warning", "error", "critical"],
      "description": "错误严重程度"
    },
    "StandardError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "description": "错误码，如 TOOL_TIMEOUT"
        },
        "category": { "$ref": "#/$defs/ErrorCategory" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "错误消息"
        },
        "retryable": {
          "type": "boolean",
          "description": "是否可重试"
        },
        "safe_to_retry": {
          "type": "boolean",
          "description": "重试是否安全（不会重复副作用）"
        },
        "severity": { "$ref": "#/$defs/ErrorSeverity" },
        "details": {
          "type": "object",
          "description": "详细信息"
        },
        "cause_ref": {
          "type": "string",
          "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "原因事件 ID"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "description": "发生时间"
        }
      },
      "required": ["code", "category", "message", "retryable", "safe_to_retry", "severity", "occurred_at"],
      "additionalProperties": false,
      "description": "标准错误对象"
    }
  }
}
