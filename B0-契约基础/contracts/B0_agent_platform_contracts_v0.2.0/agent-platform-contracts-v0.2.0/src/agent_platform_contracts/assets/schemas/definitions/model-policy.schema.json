{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "tenant_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "agent",
        "service",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Cost Usd"
        },
        "max_iterations": {
          "exclusiveMinimum": 0,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_model_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Input Tokens"
        },
        "max_model_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Output Tokens"
        },
        "max_model_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Model Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_wall_time_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Time Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_wall_time_seconds",
        "max_model_tokens",
        "max_cost_usd",
        "max_tool_calls",
        "max_iterations"
      ],
      "title": "Budget",
      "type": "object"
    },
    "CircuitBreaker": {
      "additionalProperties": false,
      "properties": {
        "failure_threshold": {
          "exclusiveMinimum": 0,
          "title": "Failure Threshold",
          "type": "integer"
        },
        "open_seconds": {
          "exclusiveMinimum": 0,
          "title": "Open Seconds",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "failure_threshold",
        "window_seconds",
        "open_seconds"
      ],
      "title": "CircuitBreaker",
      "type": "object"
    },
    "DataClassificationRule": {
      "additionalProperties": false,
      "properties": {
        "allowed_providers": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Providers",
          "type": "array"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "title": "Classification",
          "type": "string"
        },
        "require_local": {
          "default": false,
          "title": "Require Local",
          "type": "boolean"
        }
      },
      "required": [
        "classification",
        "allowed_providers"
      ],
      "title": "DataClassificationRule",
      "type": "object"
    },
    "DefinitionMetadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "maxLength": 2048,
            "type": "string"
          },
          "propertyNames": {
            "maxLength": 128
          },
          "title": "Annotations",
          "type": "object"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "key": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9-]{1,126}[a-z0-9]$",
          "title": "Key",
          "type": "string"
        },
        "labels": {
          "patternProperties": {
            "^[a-z0-9][a-z0-9._/-]{0,62}$": {
              "maxLength": 256,
              "type": "string"
            }
          },
          "title": "Labels",
          "type": "object"
        },
        "namespace": {
          "maxLength": 128,
          "minLength": 2,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,126}[a-z0-9]$",
          "title": "Namespace",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "namespace",
        "version",
        "revision",
        "scope",
        "content_digest",
        "created_at",
        "created_by"
      ],
      "title": "DefinitionMetadata",
      "type": "object"
    },
    "DefinitionPhase": {
      "enum": [
        "proposed",
        "draft",
        "testing",
        "awaiting_approval",
        "approved",
        "active",
        "deprecated",
        "blocked",
        "archived"
      ],
      "title": "DefinitionPhase",
      "type": "string"
    },
    "DefinitionStatus": {
      "additionalProperties": false,
      "properties": {
        "activated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activated At"
        },
        "observed_revision": {
          "minimum": 1,
          "title": "Observed Revision",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/DefinitionPhase"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "phase",
        "observed_revision"
      ],
      "title": "DefinitionStatus",
      "type": "object"
    },
    "FallbackStep": {
      "additionalProperties": false,
      "properties": {
        "on_error_codes": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "On Error Codes",
          "type": "array"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9-]{1,126}[a-z0-9]$",
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "on_error_codes"
      ],
      "title": "FallbackStep",
      "type": "object"
    },
    "ModelPolicySpec": {
      "additionalProperties": false,
      "properties": {
        "budget_limits": {
          "$ref": "#/$defs/Budget"
        },
        "circuit_breaker": {
          "$ref": "#/$defs/CircuitBreaker"
        },
        "data_classification_rules": {
          "items": {
            "$ref": "#/$defs/DataClassificationRule"
          },
          "minItems": 1,
          "title": "Data Classification Rules",
          "type": "array"
        },
        "fallback_chain": {
          "items": {
            "$ref": "#/$defs/FallbackStep"
          },
          "title": "Fallback Chain",
          "type": "array"
        },
        "local_model_rules": {
          "additionalProperties": true,
          "title": "Local Model Rules",
          "type": "object"
        },
        "provider_allowlist": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Provider Allowlist",
          "type": "array"
        },
        "quality_floor": {
          "enum": [
            "economy",
            "standard",
            "high",
            "frontier"
          ],
          "title": "Quality Floor",
          "type": "string"
        },
        "region_constraints": {
          "items": {
            "pattern": "^[A-Z]{2}(?:-[A-Z0-9]{1,3})?$",
            "type": "string"
          },
          "title": "Region Constraints",
          "type": "array"
        },
        "required_capabilities": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/ModelRoute"
          },
          "minItems": 1,
          "title": "Routes",
          "type": "array"
        }
      },
      "required": [
        "routes",
        "required_capabilities",
        "provider_allowlist",
        "data_classification_rules",
        "fallback_chain",
        "budget_limits",
        "quality_floor",
        "region_constraints",
        "circuit_breaker"
      ],
      "title": "ModelPolicySpec",
      "type": "object"
    },
    "ModelRoute": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "additionalProperties": true,
          "title": "Conditions",
          "type": "object"
        },
        "model": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "provider": {
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "title": "Provider",
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        },
        "route_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9-]{1,126}[a-z0-9]$",
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "provider",
        "model",
        "priority",
        "required_capabilities"
      ],
      "title": "ModelRoute",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^ses_[A-Za-z0-9._:-]{3,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "tenant_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        },
        "type": {
          "$ref": "#/$defs/ScopeType"
        },
        "user_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "required": [
        "type"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "system",
        "tenant",
        "user",
        "project",
        "session"
      ],
      "title": "ScopeType",
      "type": "string"
    }
  },
  "$id": "https://schemas.agent-platform.local/v1alpha1/model-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "agent-platform/v1alpha1",
      "default": "agent-platform/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "kind": {
      "const": "ModelPolicy",
      "default": "ModelPolicy",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/DefinitionMetadata"
    },
    "spec": {
      "$ref": "#/$defs/ModelPolicySpec"
    },
    "status": {
      "$ref": "#/$defs/DefinitionStatus"
    }
  },
  "required": [
    "metadata",
    "spec",
    "status"
  ],
  "title": "ModelPolicyResource",
  "type": "object",
  "x-contract-version": "0.2.0",
  "x-source-model": "agent_platform_contracts.models.ModelPolicyResource"
}
