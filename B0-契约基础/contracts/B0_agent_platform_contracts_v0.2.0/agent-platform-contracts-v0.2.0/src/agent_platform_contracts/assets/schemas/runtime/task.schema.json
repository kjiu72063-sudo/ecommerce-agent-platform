{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "$ref": "#/$defs/ActorType"
        },
        "tenant_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ActorType": {
      "enum": [
        "user",
        "agent",
        "service",
        "system"
      ],
      "title": "ActorType",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "Artifact",
          "default": "Artifact",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Cost Usd"
        },
        "max_iterations": {
          "exclusiveMinimum": 0,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_model_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Input Tokens"
        },
        "max_model_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Model Output Tokens"
        },
        "max_model_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Model Tokens",
          "type": "integer"
        },
        "max_tool_calls": {
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_wall_time_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Wall Time Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_wall_time_seconds",
        "max_model_tokens",
        "max_cost_usd",
        "max_tool_calls",
        "max_iterations"
      ],
      "title": "Budget",
      "type": "object"
    },
    "ErrorCategory": {
      "enum": [
        "validation",
        "authentication",
        "authorization",
        "approval",
        "budget",
        "model",
        "tool",
        "dependency",
        "conflict",
        "cancelled",
        "timeout",
        "internal"
      ],
      "title": "ErrorCategory",
      "type": "string"
    },
    "ErrorSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "ErrorSeverity",
      "type": "string"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "PermissionGrant": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "resources": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        }
      },
      "required": [
        "actions",
        "resources"
      ],
      "title": "PermissionGrant",
      "type": "object"
    },
    "ResourceKind": {
      "enum": [
        "AgentSpec",
        "SkillManifest",
        "ToolManifest",
        "PromptPackage",
        "ModelPolicy",
        "ContextPolicy",
        "LoopProfile",
        "PermissionProfile",
        "Task",
        "AgentRun",
        "Checkpoint",
        "ToolCall",
        "Approval",
        "Artifact",
        "Event"
      ],
      "title": "ResourceKind",
      "type": "string"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "title": "ResourceRef",
      "type": "object"
    },
    "RetentionPolicy": {
      "additionalProperties": false,
      "properties": {
        "delete_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delete After"
        },
        "legal_hold": {
          "default": false,
          "title": "Legal Hold",
          "type": "boolean"
        },
        "retain_days": {
          "minimum": 1,
          "title": "Retain Days",
          "type": "integer"
        }
      },
      "required": [
        "retain_days"
      ],
      "title": "RetentionPolicy",
      "type": "object"
    },
    "RoutingConstraints": {
      "additionalProperties": false,
      "properties": {
        "allowed_agent_refs": {
          "items": {
            "$ref": "#/$defs/ResourceRef"
          },
          "title": "Allowed Agent Refs",
          "type": "array"
        },
        "allowed_domains": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Domains",
          "type": "array"
        },
        "required_model_capabilities": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "title": "Required Model Capabilities",
          "type": "array"
        }
      },
      "title": "RoutingConstraints",
      "type": "object"
    },
    "RuntimeMetadata": {
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Annotations",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "id": {
          "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "id",
        "revision",
        "scope",
        "created_at",
        "created_by"
      ],
      "title": "RuntimeMetadata",
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "delay_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delay Seconds"
        },
        "execute_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execute At"
        },
        "mode": {
          "enum": [
            "immediate",
            "at",
            "delayed"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "Schedule",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "pattern": "^sch_[a-z0-9][a-z0-9._-]{2,127}$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "title": "SchemaRef",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Id"
        },
        "session_id": {
          "anyOf": [
            {
              "pattern": "^ses_[A-Za-z0-9._:-]{3,128}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "tenant_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant Id"
        },
        "type": {
          "$ref": "#/$defs/ScopeType"
        },
        "user_id": {
          "anyOf": [
            {
              "pattern": "^(?:ten|usr|prj|agt|skl|tol|prm|mpo|cpo|lop|pep|tsk|run|ckp|tcl|apr|art|evt)_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User Id"
        }
      },
      "required": [
        "type"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScopeType": {
      "enum": [
        "system",
        "tenant",
        "user",
        "project",
        "session"
      ],
      "title": "ScopeType",
      "type": "string"
    },
    "StandardError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ErrorCategory"
        },
        "cause_ref": {
          "anyOf": [
            {
              "pattern": "^evt_[0-9a-f-]{36}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cause Ref"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,127}$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "safe_to_retry": {
          "title": "Safe To Retry",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/ErrorSeverity"
        }
      },
      "required": [
        "code",
        "category",
        "message",
        "retryable",
        "safe_to_retry",
        "severity",
        "occurred_at"
      ],
      "title": "StandardError",
      "type": "object"
    },
    "TaskPhase": {
      "enum": [
        "created",
        "validated",
        "queued",
        "running",
        "waiting_input",
        "waiting_approval",
        "suspended",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ],
      "title": "TaskPhase",
      "type": "string"
    },
    "TaskSource": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "source_message_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Message Id"
        },
        "type": {
          "enum": [
            "openclaw",
            "api",
            "cron",
            "webhook",
            "ui",
            "system"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "TaskSource",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "approval_policy_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "deadline_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline At"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "domain": {
          "pattern": "^[a-z][a-z0-9_-]{1,63}$",
          "title": "Domain",
          "type": "string"
        },
        "expected_output_schema_ref": {
          "$ref": "#/$defs/SchemaRef"
        },
        "idempotency_key": {
          "maxLength": 512,
          "minLength": 8,
          "title": "Idempotency Key",
          "type": "string"
        },
        "input_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifact Refs",
          "type": "array"
        },
        "input_schema_ref": {
          "$ref": "#/$defs/SchemaRef"
        },
        "intent": {
          "pattern": "^[a-z][a-z0-9_.:-]{2,127}$",
          "title": "Intent",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "$ref": "#/$defs/ArtifactRef"
            }
          ],
          "title": "Payload"
        },
        "permission_grant": {
          "$ref": "#/$defs/PermissionGrant"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "requested_agent_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requested_by": {
          "$ref": "#/$defs/ActorRef"
        },
        "retention_policy": {
          "$ref": "#/$defs/RetentionPolicy"
        },
        "routing_constraints": {
          "$ref": "#/$defs/RoutingConstraints"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Schedule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/TaskSource"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "intent",
        "domain",
        "requested_by",
        "source",
        "payload",
        "input_schema_ref",
        "expected_output_schema_ref",
        "routing_constraints",
        "priority",
        "budget",
        "permission_grant",
        "idempotency_key",
        "retention_policy"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "TaskStatus": {
      "additionalProperties": false,
      "properties": {
        "active_run_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StandardError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "final_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phase": {
          "$ref": "#/$defs/TaskPhase"
        }
      },
      "required": [
        "phase"
      ],
      "title": "TaskStatus",
      "type": "object"
    }
  },
  "$id": "https://schemas.agent-platform.local/v1alpha1/task.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "agent-platform/v1alpha1",
      "default": "agent-platform/v1alpha1",
      "title": "Api Version",
      "type": "string"
    },
    "kind": {
      "const": "Task",
      "default": "Task",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/RuntimeMetadata"
    },
    "spec": {
      "$ref": "#/$defs/TaskSpec"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    }
  },
  "required": [
    "metadata",
    "spec",
    "status"
  ],
  "title": "TaskResource",
  "type": "object",
  "x-contract-version": "0.2.0",
  "x-source-model": "agent_platform_contracts.models.TaskResource"
}
