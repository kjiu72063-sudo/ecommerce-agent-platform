# ---- 虚拟环境与依赖 ----
.venv/
venv/
env/
__pypackages__/

# ---- Python 解释器缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.pyd

# ---- 构建与打包产物 ----
build/
dist/
*.egg-info/
.eggs/
wheels/
*.whl

# ---- 测试、覆盖率与质量工具缓存 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.pytype_cache/
.pyre/

# ---- 本地 AI/开发工具状态 ----
.zcode/
.mimocode/

# ---- 编辑器与系统文件 ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 本地运行时数据（SQLite 等） ----
*.db
*.sqlite
*.sqlite3

# ---- 日志 ----
*.log
logs/

# ---- 环境变量 / 密钥（绝不入库） ----
.env
.env.*
!.env.example
*.pem
*.key